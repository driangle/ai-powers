#!/bin/sh
# Runs depdiff.py with the Python and libraries it needs, fetched and cached by uv.
# tomllib needs Python 3.11+; pyyaml parses pnpm and yarn berry lockfiles.
here="$(cd "$(dirname "$0")" && pwd)"
exec uv run --quiet --no-project --python '>=3.11' --with 'pyyaml>=6,<7' \
  python "$here/depdiff.py" "$@"
